# Telorax environment configuration
# Path: /etc/telorax/.env

APP_TIMEZONE=UTC
APP_HOST=0.0.0.0
APP_PORT=8000

AUTH_USERNAME=telorax
AUTH_PASSWORD=changeme

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telorax
DB_USER=telorax
DB_PASSWORD=secret
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

TELEGRAM_DEFAULT_API_ID=0
TELEGRAM_DEFAULT_API_HASH=
TELEGRAM_CONNECTION_TIMEOUT=1
TELEGRAM_CONNECTION_RETRIES=0
TELEGRAM_REQUEST_RETRIES=0

WORKER_CYCLE_INTERVAL_SECONDS=15
WORKER_MAX_CONCURRENT_ACCOUNTS=500
WORKER_CAMPAIGN_BATCH_SIZE=100
WORKER_ISOLATED_ACCOUNT_LIMIT=30
WORKER_RESHOT_ACCOUNT_LIMIT=100
WORKER_RESHOT_GROUPS=
WORKER_RESHOT_MESSAGE_LIMIT=100
WORKER_CYCLE_TIMEOUT_SECONDS=120
WORKER_FALLBACK_POLL_SECONDS=60

PROXY_URL=
PROXY_USE_GLOBAL=false

EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_BASE_DOMAIN=
EMAIL_DEFAULT_2FA_PASSWORD=

MASTER_KEY_ENV=TELORAX_MASTER_KEY

LOG_LEVEL=INFO
LOG_JSON=true
