[Unit]
Description=Telorax Telegram Automation Service
After=network.target telorax-mariadb.service telorax-redis.service
Wants=telorax-mariadb.service telorax-redis.service

[Service]
Type=simple
User=telorax
Group=telorax
WorkingDirectory=/etc/telorax
EnvironmentFile=/etc/telorax/.env
ExecStart=/usr/local/bin/telorax serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
