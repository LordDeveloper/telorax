<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TeloraxAgent" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Telorax.Button</item>
        <item name="textInputStyle">@style/Widget.Telorax.TextInputLayout</item>
    </style>

    <style name="Widget.Telorax.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">999dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Widget.Telorax.Button.Success" parent="Widget.Telorax.Button">
        <item name="backgroundTint">@color/success</item>
    </style>

    <style name="Widget.Telorax.Button.Danger" parent="Widget.Telorax.Button">
        <item name="backgroundTint">@color/danger</item>
    </style>

    <style name="Widget.Telorax.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">999dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Telorax.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Telorax.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Telorax.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Telorax.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Telorax.StatusChip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
